# detecto — environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust as needed:
#
#     cp .env.example .env
#
# The real `.env` is gitignored. This template is committed as documentation.
# Every value here has a safe default in code, so the app boots with no .env.
# ---------------------------------------------------------------------------

# --- Model -----------------------------------------------------------------
# Path to the exported YOLOv8n ONNX model (relative to the backend working dir).
# See README "Obtaining the model" — export once on Colab, drop the file here.
MODEL_PATH=weights/yolov8n.onnx

# Input resolution fed to the model. The model was exported at 640.
# Lowering to 416 or 320 speeds up CPU inference at some accuracy cost.
# 640 = most accurate/slowest; 416 = balanced; 320 = fastest/least accurate.
IMG_SIZE=640

# --- Detection thresholds --------------------------------------------------
# Minimum confidence for a box to count as a person (brief: default 0.5).
CONF_THRESHOLD=0.5

# IoU threshold for Non-Maximum Suppression. Lower = stricter de-duplication
# of overlapping boxes. 0.45 is the ultralytics default.
NMS_IOU_THRESHOLD=0.45

# COCO class index for "person". Fixed by the dataset, but kept explicit so
# the filter is self-documenting and swappable for another class.
PERSON_CLASS_ID=0

# Optional CLAHE contrast enhancement, applied before letterboxing.
# Off by default: helps low-contrast/poorly-lit frames but can hurt
# well-exposed images, so it is a tunable rather than a default.
ENHANCE_CONTRAST=false

# --- Upload limits ---------------------------------------------------------
# Reject uploads larger than this (HTTP 413). Guards memory on the small host.
MAX_UPLOAD_MB=10

# Allowed MIME types, comma-separated.
ALLOWED_MIME_TYPES=image/jpeg,image/png

# --- Storage ---------------------------------------------------------------
# SQLite database file. Created on first run if missing.
DB_PATH=data/detecto.db

# Default number of history rows returned by GET /history.
HISTORY_DEFAULT_LIMIT=100

# --- Server / CORS ---------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Comma-separated allowed origins. NEVER use "*" — list real origins.
# Dev: the Vite dev server. Prod: your deployed frontend origin(s).
CORS_ORIGINS=http://localhost:5173

# --- Runtime tuning --------------------------------------------------------
# onnxruntime intra-op threads. Target machine has 4 logical cores; set to
# the core count (or leave blank to let onnxruntime decide).
ORT_NUM_THREADS=4
